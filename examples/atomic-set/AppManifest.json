{
    "manifestVersion": "v3",
    "name": "atomic-set",
    "interfaces": [
        {
            "type": "vehicle-signal-interface",
            "config": {
                "src": "https://github.com/COVESA/vehicle_signal_specification/releases/download/v6.1/vss.json",
                "datapoints": {
                    "required": [
                        {
                            "path": "Vehicle.Cabin.Seat.Row1.DriverSide.Position",
                            "access": "write"
                        },
                        {
                            "path": "Vehicle.Cabin.Seat.Row1.PassengerSide.Position",
                            "access": "write"
                        }
                    ]
                }
            }
        },
        {
            "type": "pubsub",
            "config": {
                "reads": [
                    "vehicleapp/setValue/request"
                ],
                "writes": [
                    "vehicleapp/setValue/response",
                ]
            }
        }
    ]
}
